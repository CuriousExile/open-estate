{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo",
    // aws-cdk-lib typings break under this flag (e.g. `Bucket` vs `IBucket.isWebsite`).
    "exactOptionalPropertyTypes": false
  },
  "include": ["src/**/*.ts"],
  "references": [
    { "path": "../shared" },
    { "path": "../core" },
    { "path": "../api" },
    { "path": "../mcp" },
    { "path": "../ingestion" },
    { "path": "../admin" },
    { "path": "../management" },
    { "path": "./scripts" }
  ]
}

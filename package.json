{
  "name": "open-estate",
  "version": "0.0.0",
  "private": true,
  "description": "Open-source, serverless real estate search platform for humans and AI agents",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/CuriousExile/open-estate.git"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0",
    "npm": ">=10"
  },
  "workspaces": [
    "packages/shared",
    "packages/core",
    "packages/api",
    "packages/mcp",
    "packages/admin",
    "packages/management",
    "packages/ingestion",
    "packages/frontend",
    "packages/infra",
    "packages/loadtest",
    "packages/devserver"
  ],
  "scripts": {
    "build": "tsc -b && npm run build --workspace @open-estate/frontend",
    "clean": "tsc -b --clean",
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsc -b packages/devserver && node packages/devserver/dist/main.js",
    "lint": "eslint . && prettier --check . && npm run check:config",
    "check:config": "node scripts/check-hardcoded-config.mjs",
    "docs:permissions": "tsc -b packages/shared && node scripts/generate-permission-matrix.mjs",
    "format": "prettier --write .",
    "test": "jest",
    "test:full": "OPEN_ESTATE_TEST_TIER=full jest",
    "test:shared": "jest --selectProjects shared",
    "test:search": "jest --selectProjects search",
    "test:management": "jest --selectProjects management",
    "test:ingestion": "jest --selectProjects ingestion",
    "test:platform": "jest --selectProjects platform",
    "test:frontend": "jest --selectProjects frontend",
    "test:infra": "jest --selectProjects infra",
    "typecheck:tests": "tsc -p tsconfig.test.json && tsc -p packages/infra/tsconfig.test.json && tsc -p packages/frontend/tsconfig.test.json",
    "test:integration": "DYNAMODB_ENDPOINT=${DYNAMODB_ENDPOINT:-http://localhost:8000} OPENSEARCH_ENDPOINT=${OPENSEARCH_ENDPOINT:-http://localhost:9200} OPEN_ESTATE_TEST_TIER=full jest --forceExit --testPathPatterns '\\.integration\\.test\\.ts$'",
    "test:e2e": "OPEN_ESTATE_TEST_TIER=full jest --forceExit --runInBand --testPathPatterns '\\.e2e\\.test\\.ts$'",
    "synth": "npm run synth --workspace @open-estate/infra",
    "verify": "npm run lint && npm run build && npm run typecheck:tests && npm run test:full && npm run synth",
    "everything": "node scripts/run-everything.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@seriousme/openapi-schema-validator": "2.11.0",
    "@types/jest": "30.0.0",
    "@types/node": "20.19.43",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "jest": "30.5.2",
    "prettier": "3.9.9",
    "ts-jest": "29.4.14",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1"
  }
}
